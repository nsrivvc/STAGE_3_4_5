# =============================================================================
# LOCAL environment for the STAGE 3-5 code (run.py and src/) ONLY.
#
# - Read by src/config.py via python-dotenv when you run `python run.py ...`
#   on this machine. GitHub Actions NEVER reads this file — every workflow
#   gets its connection string from the repo secret DATABASE_URL
#   (Settings -> Secrets and variables -> Actions).
# - The stage 1-2 ingestion subproject has its OWN .env at
#   src/transformations/stage_1_2(ingestion)/.env — this file does not
#   configure it.
# - SECURITY: this file holds a real credential and should NOT be tracked by
#   git. If it still is: `git rm --cached .env`, add `.env` to .gitignore,
#   push, then rotate the Neon password (history keeps the old value).
# =============================================================================

# Which database backend to write to (only postgres is implemented).
DB_TYPE=postgres

# --- Neon / Postgres ---------------------------------------------------------
# The full connection string from Neon's "Connect" dialog. Everything the
# stage 3-5 runner touches (bronze / silver_staging / silver schemas) lives in
# this one database. sslmode + channel_binding are required by Neon.
DATABASE_URL=postgresql://neondb_owner:npg_D24VlJSQsIeP@ep-broad-mode-atg4rfig-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Optional overrides (defaults shown; uncomment to change) ----------------
# Schema the raw feeds land in (written by stage 2, read by stage 3):
# BRONZE_SCHEMA=bronze
# Schema for stage-3 staging output (dedup/amended/decomposed tables):
# DECOMP_SCHEMA=silver_staging
# Schema for stage 4/5 output (rec-del pairs, master capacity, finals):
# SILVER_SCHEMA=silver
# Where run.py writes its per-run Parquet exports (empty string disables):
# PARQUET_OUTPUT_DIR=parquet_output
# Logging verbosity for the runner:
# LOG_LEVEL=INFO
